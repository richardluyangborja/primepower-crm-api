APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Public origin of the frontend. Used to build absolute client survey links
# (/survey/{token}). MUST be set to the real frontend URL in production —
# otherwise survey links point at localhost.
FRONTEND_URL=http://localhost:5173
# Comma-separated extra origins merged into config/cors.php allowed_origins.
# CORS_ALLOWED_ORIGINS=https://crm-frontend-primepower.hostforgeplatforms.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# Minutes a session (and its CSRF cookie) stays alive. Must comfortably
# cover the email-OTP ceremony: request code → open Gmail → type 6 digits.
SESSION_LIFETIME=120
# Seconds of inactivity before SessionIdleTimeout logs the user out.
SESSION_IDLE_TIMEOUT=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Local (http://localhost): keep defaults below — Secure=false, SameSite=lax.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
# Production (cross-subdomain HTTPS, e.g. crm-frontend-*.hostforgeplatforms.com
# calling primepower-crm-api-*.hostforgeplatforms.com) must use:
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=none
# SESSION_PARTITIONED_COOKIE=true
# SESSION_DOMAIN=null
# SANCTUM_STATEFUL_DOMAINS=crm-frontend-primepower.hostforgeplatforms.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail SMTP (App Password — requires Google 2-Step Verification ON).
# 1. Google Account → Security → 2-Step Verification → turn ON.
# 2. Security → App passwords → create one named e.g. "PrimePower CRM".
# 3. Paste the 16-char code below (spaces OK, keep the quotes).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="your-sender@gmail.com"
MAIL_PASSWORD="xxxx xxxx xxxx xxxx"
MAIL_FROM_ADDRESS="your-sender@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Email OTP two-factor auth (login verification codes).
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI (Gemini, free tier) — get a key at https://aistudio.google.com/apikey
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
# AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# AI reports (Groq) — get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions

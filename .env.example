APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Comma-separated extra origins merged into config/cors.php allowed_origins.
# CORS_ALLOWED_ORIGINS=https://crm-frontend-primepower.hostforgeplatforms.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=1
SESSION_IDLE_TIMEOUT=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Local (http://localhost): keep defaults below — Secure=false, SameSite=lax.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
# Production (cross-subdomain HTTPS, e.g. crm-frontend-*.hostforgeplatforms.com
# calling primepower-crm-api-*.hostforgeplatforms.com) must use:
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=none
# SESSION_PARTITIONED_COOKIE=true
# SESSION_DOMAIN=null
# SANCTUM_STATEFUL_DOMAINS=crm-frontend-primepower.hostforgeplatforms.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI (Gemini, free tier) — get a key at https://aistudio.google.com/apikey
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
# AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# AI reports (Groq) — get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
